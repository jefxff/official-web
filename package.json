{
  "name": "fmw-app",
  "version": "1.0.0",
  "private": true,
  "description": "富满微官网 (FMW Official Website) — Next.js 15 App Router, bilingual, dual-region (CN/Global).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx scripts/seed.ts",
    "seed": "tsx scripts/seed.ts",
    "db:constraint": "psql \"$DATABASE_URL\" -f prisma/constraint.sql",
    "test:schema": "tsx scripts/test-zod-behavior.ts",
    "audit": "tsx scripts/audit-gate.ts",
    "audit:raw": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "dayjs": "^1.11.13",
    "jose": "^5.9.6",
    "next": "^15.5.4",
    "next-intl": "^3.26.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "deepmerge-ts": "^8.0.2"
  }
}
