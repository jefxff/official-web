# ===== 数据源 =====
# seed = 只读本地 JSON（默认，无需数据库即可 dev/build）
# db   = 接入 PostgreSQL（后台写接口与发布管线需要）
DATA_SOURCE=seed
DATABASE_URL=postgresql://user:pass@localhost:5432/fmw?schema=public

# ===== 双区域构建 =====
# cn | global
BUILD_TARGET=cn
NEXT_PUBLIC_SITE_URL=https://www.fmw.example
# NEXT_PUBLIC_ASSET_PREFIX=https://cdn.fmw.example   # 可选，global 走 CF

# ===== 后台管理员（TOTP 二步验证）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# base32 密钥；用 `npx --yes otplib-cli generate-secret` 生成
ADMIN_TOTP_SECRET=
# 会话 JWT 签名密钥（生产必须替换为强随机值）
AUTH_SECRET=dev-only-insecure-secret-change-me

# ===== Cloudflare 边缘缓存失效 =====
CF_ZONE_ID=
CF_API_TOKEN=

# ===== Meilisearch 搜索同步（可选，未配置则 no-op）=====
MEILI_HOST=
MEILI_API_KEY=

# ===== AI 助手（P24，建议作为上线后 M1 增量，用开关控制）=====
# 服务端开关；false 时 /api/v1/ai/chat 返回 503
AI_ASSISTANT_ENABLED=true
# 客户端开关；false 时不渲染悬浮组件
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=true
# 未配置 AI_LLM_API_KEY 时自动回退 Mock Provider（无需外网，基于已验证资料作答）
# AI_LLM_API_KEY=
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_LLM_MODEL=gpt-4o-mini

# ===== 可观测性（基础包零依赖；设 SENTRY_DSN 可在 observability 包的扩展点接入 APM）=====
# SENTRY_DSN=
LOG_LEVEL=info
